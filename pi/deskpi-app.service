# /etc/systemd/system/deskpi-app.service
# Server Nuxt di produzione (build in /opt/deskpi) — serve dashboard, /admin e API sulla porta 3000.

[Unit]
Description=DeskPi app (server Nuxt di produzione)
After=network.target

[Service]
Type=simple
User=raux
WorkingDirectory=/opt/deskpi
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3000
# Dove vengono salvate note e contenuti (sopravvive ai deploy)
Environment=DESKPI_DATA_DIR=/var/lib/deskpi
StateDirectory=deskpi
ExecStart=/usr/bin/node /opt/deskpi/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
