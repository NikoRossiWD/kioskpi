# /etc/default/deskpi — impostazioni del kiosk DeskPi
# Dopo una modifica: sudo systemctl restart deskpi-kiosk

# Pagina da mostrare a schermo intero.
# Normale: l'app servita dal Pi stesso (deskpi-app.service).
DESKPI_URL=http://localhost:3000/?kiosk

# Sviluppo con hot reload dal PC: commenta la riga sopra e usa l'IP del PC, es.
# DESKPI_URL=http://192.168.0.133:3000/?kiosk
