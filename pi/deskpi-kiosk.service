# /etc/systemd/system/deskpi-kiosk.service
# Mostra la dashboard a schermo intero sul monitor (tty1) all'avvio: cage + Chromium.
# La console testuale resta disponibile con Ctrl+Alt+F2.

[Unit]
Description=DeskPi kiosk (cage + Chromium)
After=systemd-user-sessions.service network-online.target dbus.socket systemd-logind.service
Wants=network-online.target dbus.socket systemd-logind.service
# Prende il posto del login testuale sul monitor (tty1)
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=raux
EnvironmentFile=-/etc/default/deskpi
# -s: permette di cambiare console (Ctrl+Alt+F2) mentre cage è attivo
ExecStart=/usr/bin/cage -s -- /usr/local/bin/deskpi-browser
Restart=always
RestartSec=5

# Sessione grafica "vera" sul monitor fisico (necessaria a cage per usare schermo e input)
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

[Install]
WantedBy=multi-user.target
