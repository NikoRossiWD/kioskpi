rules_version = '2';

// Regole Firestore (valgono anche negli emulatori).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{doc} {
      // TODO prima di andare online: la lettura pubblica va bene solo in locale.
      // In produzione anche il kiosk dovrà autenticarsi (es. account dedicato al Pi).
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
